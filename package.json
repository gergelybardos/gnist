{
  "name": "@gergelybardos/gnist",
  "version": "0.2.0",
  "description": "Lightweight, renderer-agnostic particle simulation engine built with vanilla JavaScript for real-time visual effects",
  "keywords": [
    "animation",
    "canvas",
    "esm",
    "lightweight",
    "particle",
    "particle-engine",
    "particle-system",
    "simulation",
    "vanilla-js",
    "vfx",
    "visual-effects",
    "webgl"
  ],
  "author": "Gergely BÁRDOS (https://github.com/gergelybardos)",
  "license": "MIT",
  "homepage": "https://github.com/gergelybardos/gnist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergelybardos/gnist.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.6.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:canvas": "vite --mode canvas",
    "dev:webgl": "vite --mode webgl",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc",
    "doc:api": "jsdoc -c jsdoc.json -R docs/src/api/homepage.md",
    "doc:deploy": "npm run doc:api && gh-pages -d docs/site",
    "version:changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.raw.md -s",
    "prepublishOnly": "npm run lint && npm run types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "docdash": "^2.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "jsdoc-ts-utils": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
