{
  "source": {
    "include": ["src"],
    "includePattern": "\\.js$",
    "excludePattern": "(node_modules|dist|build|tests)"
  },
  "opts": {
    "destination": "docs/site/api",
    "recurse": true,
    "template": "node_modules/docdash"
  },
  "plugins": [
    "jsdoc-ts-utils"
  ],
  "docdash": {
    "meta": {
      "title": "Gnist API Reference"
    },
    "search": true,
    "collapse": true,
    "wrap": true,
    "typedefs": true,
    "sectionOrder": [
      "Classes",
      "Global"
    ]
  }
}
